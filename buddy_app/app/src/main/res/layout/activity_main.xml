<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen view handed to Buddy's native face (BuddySDK.UI.setViewAsFace).
     A small panel at the bottom sets the laptop address; it hides once connected. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/view_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#CC1A2233"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/server_url"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:hint="ws://192.168.1.10:8000/ws/robot"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF" />

        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="#991A2233"
        android:padding="6dp"
        android:text="Starting…"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</FrameLayout>
